{
    "name": "my-portfolio",
    "version": "0.5.0",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "deploy": "npm run minify && npm run build && gh-pages -d build --cname austingause.com --nojekyll",
        "preview": "vite preview",
        "minify": "npx tailwindcss -i ./input.css -o ./static/css/output.css --minify",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "watch": "npx tailwindcss -i ./input.css -o ./static/css/output.css --watch"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.10",
        "gh-pages": "^6.3.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^3.4.1",
        "tslib": "^2.4.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    },
    "type": "module",
    "dependencies": {
        "@sanity/client": "^7.12.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
